# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EXTRACT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Qdrant Cloud cluster URL (include :6333) and API key
QDRANT_URL=
QDRANT_API_KEY=

# Neo4j: local Docker (bolt://localhost:7687) or Neo4j Aura (neo4j+s://<id>.databases.neo4j.io)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=simplyreview-dev

# When set, uploading and deleting papers require this key (set it on the public deployment)
ADMIN_TOKEN=
